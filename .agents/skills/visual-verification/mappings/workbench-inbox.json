{
  "view": "workbench-inbox",
  "mockup": "docs/superpowers/specs/2026-07-06-workbench-mockup.html",
  "app": "composer-app → Personal Space → Inbox (requires ≥1 synced Capture)",
  "note": "Expected values are extracted from the mockup's <style> block (cited per region). The canonical upgrade is to render the mockup and harvest the same props with harvest-styles.js so expected and actual are both browser-resolved; until then these are the source-CSS values with tolerant color/length comparison. Selectors are data-testids on the plugin source.",
  "viewport": { "width": 1400, "height": 900 },
  "tolerances": { "lengthPx": 1, "colorChannel": 6, "weight": 40 },
  "regions": [
    {
